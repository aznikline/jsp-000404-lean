namespace Jsp404.N4R2ReplayData.LeafShard000
open N4R2RowDataReplay

def check : Bool := decide (∀ j : Fin 32,
  leafCheck library (N4R2WordTree.catalog (Fin.ofNat 24698 (0 + j.val))) (lookup j.val) = true)

theorem check_true : check = true := by decide +kernel

theorem point_checked (j : Fin 32) :
    leafCheck library (N4R2WordTree.catalog (Fin.ofNat 24698 (0 + j.val))) (lookup j.val) = true :=
  (of_decide_eq_true check_true) j

theorem correct (id : Fin 24698) (hlow : 0 ≤ id.val) (hhigh : id.val < 32) :
    leafCheck library (N4R2WordTree.catalog id) (lookup (id.val - 0)) = true := by
  let j : Fin 32 := ⟨id.val - 0, by omega⟩
  have hsum : 0 + j.val = id.val := by dsimp [j]; omega
  have hindex : Fin.ofNat 24698 (0 + j.val) = id := by
    apply Fin.ext
    simp only [Fin.ofNat, hsum, Nat.mod_eq_of_lt id.isLt]
  have hh := point_checked j
  rw [hindex] at hh
  exact hh

#print axioms point_checked
#print axioms correct

end Jsp404.N4R2ReplayData.LeafShard000
