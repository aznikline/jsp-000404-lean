theorem mask216_impossible (M : GenericModel 5 4)
    (hword : WordSound M SixWeakAllGroup02Data.Mask216.word)
    (hdef1 : SatScalarModel.rowDefect M 1 ≤ 2)
    (hdef3 : SatScalarModel.rowDefect M 3 ≤ 3)
    : False := by
  exact SixWeakOuterReplaySoundness.leafCheckA_sound M SixWeakAllGroup02Data.Mask216.word hword SixWeakAllGroup02Data.Mask216.rows
