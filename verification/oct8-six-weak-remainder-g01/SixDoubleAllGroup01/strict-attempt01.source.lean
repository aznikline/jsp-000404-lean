theorem mask001_impossible (M : GenericModel 5 4)
    (hword : WordSound M SixDoubleAllGroup01Data.Mask001.word)
    (hdef0 : SatScalarModel.rowDefect M 0 ≤ 2)
    (hdef2 : SatScalarModel.rowDefect M 2 ≤ 2)
    : False := by
  exact SixWeakOuterReplaySoundness.leafCheckB_sound M SixDoubleAllGroup01Data.Mask001.word hword SixDoubleAllGroup01Data.Mask001.rows
