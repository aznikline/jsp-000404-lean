      e ≠ 0 →
        ∀ {rho upper lam : ℝ} {c : Fin (s + 2) → Plane₂},
          Jsp404.ActualMinimalBandCounterexample.Model o e rho upper 16 (s + 2) c lam →
            ∀ (p : Fin (s + 2)) (q : Fin (s + 1)),
              Jsp404.rowScore lam (Jsp404.directionRow o e c p) = 0 →
                Jsp404.rowScore lam (Jsp404.directionRow o e c (p.succAbove q)) = 0 →
                  ∀ (a : Fin s),
                    0 < Jsp404.rowScore lam (Jsp404.directionRow o e c (p.succAbove (q.succAbove a))) →
                      Jsp404.IsHullVertex c (p.succAbove (q.succAbove a)) →
                        Jsp404.potential lam (Jsp404.directionRows o e c) = 17 ∧
                          ∃ W W',
                            Jsp404.gapScore lam (Real.pi - W'.width) = Jsp404.gapScore lam (Real.pi - W.width) ∧
