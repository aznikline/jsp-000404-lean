theorem mask949_impossible (M : GenericModel 5 4)
    (hword : WordSound M SixDoubleAllGroup04Data.Mask949.word)
    (hdef0 : SatScalarModel.rowDefect M 0 ≤ 2)
    (hdef2 : SatScalarModel.rowDefect M 2 ≤ 2)
    : False := by
  exact SixWeakOuterReplaySoundness.leafCheckB_sound M SixDoubleAllGroup04Data.Mask949.word hword SixDoubleAllGroup04Data.Mask949.rows
    (SixWeakAllGroup04Rows.rows_actual_mask949 M hword) hdef0 hdef2 SixDoubleAllGroup04Data.Mask949.library SixDoubleAllGroup04Data.Mask949.ids SixDoubleAllGroup04Data.Mask949.point_checked

#print axioms mask949_impossible

