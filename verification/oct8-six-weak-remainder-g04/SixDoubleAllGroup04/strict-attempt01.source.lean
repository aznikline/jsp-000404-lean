theorem group_impossible (M : GenericModel 5 4) (j : Fin 10)
    (hword : WordSound M (SixOuterWordCatalogComplete.wordOfMask
      (SixOuterWordCatalogComplete.catalog (SixWeakAllGroup04Rows.catalogIndices j))))
    (hdef0 : SatScalarModel.rowDefect M 0 ≤ 2)
    (hdef2 : SatScalarModel.rowDefect M 2 ≤ 2)
    : False := by
  fin_cases j
  · change WordSound M (SixOuterWordCatalogComplete.wordOfMask
      (SixOuterWordCatalogComplete.catalog (51 : Fin 62))) at hword
    rw [← SixWeakAllGroup04Rows.double_word_catalog_mask949] at hword
    exact mask949_impossible M hword hdef0 hdef2
  · change WordSound M (SixOuterWordCatalogComplete.wordOfMask
      (SixOuterWordCatalogComplete.catalog (52 : Fin 62))) at hword
    rw [← SixWeakAllGroup04Rows.double_word_catalog_mask951] at hword
    exact mask951_impossible M hword hdef0 hdef2
  · change WordSound M (SixOuterWordCatalogComplete.wordOfMask
      (SixOuterWordCatalogComplete.catalog (53 : Fin 62))) at hword
    rw [← SixWeakAllGroup04Rows.double_word_catalog_mask959] at hword
    exact mask959_impossible M hword hdef0 hdef2
  · change WordSound M (SixOuterWordCatalogComplete.wordOfMask
      (SixOuterWordCatalogComplete.catalog (54 : Fin 62))) at hword
    rw [← SixWeakAllGroup04Rows.double_word_catalog_mask960] at hword
    exact mask960_impossible M hword hdef0 hdef2
  · change WordSound M (SixOuterWordCatalogComplete.wordOfMask
      (SixOuterWordCatalogComplete.catalog (55 : Fin 62))) at hword
    rw [← SixWeakAllGroup04Rows.double_word_catalog_mask992] at hword
    exact mask992_impossible M hword hdef0 hdef2
  · change WordSound M (SixOuterWordCatalogComplete.wordOfMask
      (SixOuterWordCatalogComplete.catalog (56 : Fin 62))) at hword
    rw [← SixWeakAllGroup04Rows.double_word_catalog_mask1008] at hword
    exact mask1008_impossible M hword hdef0 hdef2
  · change WordSound M (SixOuterWordCatalogComplete.wordOfMask
      (SixOuterWordCatalogComplete.catalog (57 : Fin 62))) at hword
    rw [← SixWeakAllGroup04Rows.double_word_catalog_mask1012] at hword
    exact mask1012_impossible M hword hdef0 hdef2
  · change WordSound M (SixOuterWordCatalogComplete.wordOfMask
      (SixOuterWordCatalogComplete.catalog (58 : Fin 62))) at hword
    rw [← SixWeakAllGroup04Rows.double_word_catalog_mask1016] at hword
    exact mask1016_impossible M hword hdef0 hdef2
  · change WordSound M (SixOuterWordCatalogComplete.wordOfMask
      (SixOuterWordCatalogComplete.catalog (59 : Fin 62))) at hword
    rw [← SixWeakAllGroup04Rows.double_word_catalog_mask1020] at hword
    exact mask1020_impossible M hword hdef0 hdef2
  · change WordSound M (SixOuterWordCatalogComplete.wordOfMask
      (SixOuterWordCatalogComplete.catalog (60 : Fin 62))) at hword
    rw [← SixWeakAllGroup04Rows.double_word_catalog_mask1022] at hword
    exact mask1022_impossible M hword hdef0 hdef2

