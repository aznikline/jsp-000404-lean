    · exfalso
      rcases m.htr 0 1 3 (by decide) (by decide) with h | h <;> rcases m.htr 0 1 4 (by decide) (by decide) with h | h <;> rcases m.htr 1 3 4 (by decide) (by decide) with h | h <;> linarith
  · obtain ⟨rfl, rfl, rfl, rfl⟩ := h
    rcases hg with hg | hg | hg | hg | hg
    · exfalso
      rcases m.htr 1 3 4 (by decide) (by decide) with h | h <;> linarith
    · exfalso
      rcases m.htr 0 2 4 (by decide) (by decide) with h | h <;> linarith
    · exfalso
      rcases m.htr 0 2 4 (by decide) (by decide) with h | h <;> linarith
    · exfalso
      rcases m.htr 1 2 4 (by decide) (by decide) with h | h <;> linarith
    · exfalso
      rcases m.htr 0 1 2 (by decide) (by decide) with h | h <;> rcases m.htr 0 2 4 (by decide) (by decide) with h | h <;> rcases m.htr 1 2 4 (by decide) (by decide) with h | h <;> linarith
  · obtain ⟨rfl, rfl, rfl, rfl⟩ := h
    rcases hg with hg | hg | hg | hg | hg
    · exfalso
      rcases m.htr 2 3 4 (by decide) (by decide) with h | h <;> linarith
    · exfalso
      rcases m.htr 0 2 4 (by decide) (by decide) with h | h <;> linarith
    · exfalso
      rcases m.htr 0 2 4 (by decide) (by decide) with h | h <;> linarith
    · exfalso
      rcases m.htr 1 2 4 (by decide) (by decide) with h | h <;> linarith
    · exfalso
      rcases m.htr 1 2 3 (by decide) (by decide) with h | h <;> rcases m.htr 1 2 4 (by decide) (by decide) with h | h <;> rcases m.htr 2 3 4 (by decide) (by decide) with h | h <;> linarith
  · obtain ⟨rfl, rfl, rfl, rfl⟩ := h
    rcases hg with hg | hg | hg | hg | hg
    · exfalso
      rcases m.htr 2 3 4 (by decide) (by decide) with h | h <;> linarith
