      rcases m.htr 0 1 4 (by decide) (by decide) with h | h <;> linarith
    · exfalso
      rcases m.htr 0 1 4 (by decide) (by decide) with h | h <;> linarith
    · exfalso
      rcases m.htr 1 2 3 (by decide) (by decide) with h | h <;> rcases m.htr 1 2 4 (by decide) (by decide) with h | h <;> rcases m.htr 2 3 4 (by decide) (by decide) with h | h <;> linarith

theorem n3_between (m : N3Model) {x0 x1 x2 x3 y0 y1 y2 y3 : ℝ}
    (hp0 : List.Perm [x0, x1, x2, x3] [m.d 0 1, m.d 0 2, m.d 0 3, m.d 0 4])
    (hs0 : RowSig m.lam m.p (m.t 0) x0 x1 x2 x3)
    (hp4 : List.Perm [y0, y1, y2, y3] [m.d 0 4, m.d 1 4, m.d 2 4, m.d 3 4])
    (hs4 : RowSig m.lam m.p (m.t 4) y0 y1 y2 y3) :
    False := by
  have s0 := n3_row0 m hp0 hs0
  have s4 := n3_row4 m hp4 hs4
  have hc01 := m.hcor 0 1 (by decide)
  have hc02 := m.hcor 0 2 (by decide)
  have hc03 := m.hcor 0 3 (by decide)
  have hc04 := m.hcor 0 4 (by decide)
  have hc12 := m.hcor 1 2 (by decide)
  have hc13 := m.hcor 1 3 (by decide)
  have hc14 := m.hcor 1 4 (by decide)
  have hc23 := m.hcor 2 3 (by decide)
  have hc24 := m.hcor 2 4 (by decide)
  have hc34 := m.hcor 3 4 (by decide)
  obtain ⟨hplo, hphi⟩ := m.hp
  have hlam := m.hlam
  have ht0b := m.ht0
  have ht4b := m.ht4
  have ht01 : m.t 0 < m.t 1 := m.ht (by decide)
  have ht02 : m.t 0 < m.t 2 := m.ht (by decide)
  have ht03 : m.t 0 < m.t 3 := m.ht (by decide)
  have ht04 : m.t 0 < m.t 4 := m.ht (by decide)
  have ht12 : m.t 1 < m.t 2 := m.ht (by decide)
  have ht13 : m.t 1 < m.t 3 := m.ht (by decide)
  have ht14 : m.t 1 < m.t 4 := m.ht (by decide)
  have ht23 : m.t 2 < m.t 3 := m.ht (by decide)
  have ht24 : m.t 2 < m.t 4 := m.ht (by decide)
  have ht34 : m.t 3 < m.t 4 := m.ht (by decide)
  rcases s0 with h0 | h0 | h0 <;> rcases s4 with h4 | h4 | h4
  · obtain ⟨e0, e1, e2, e3, sb0, sb1, sb2, sb3, sb4, ga0, ga1, ga2, ga3, ga4⟩ := h0
    obtain ⟨f0, f1, f2, f3, tb0, tb1, tb2, tb3, tb4, gb0, gb1, gb2, gb3, gb4⟩ := h4
    subst e0 e1 e2 e3 f0 f1 f2 f3
    linarith
  · obtain ⟨e0, e1, e2, e3, sb0, sb1, sb2, sb3, sb4, ga0, ga1, ga2, ga3, ga4⟩ := h0
    obtain ⟨f0, f1, f2, f3, tb0, tb1, tb2, tb3, tb4, gb0, gb1, gb2, gb3, gb4⟩ := h4
    subst e0 e1 e2 e3 f0 f1 f2 f3
    rcases m.htr 0 1 4 (by decide) (by decide) with h | h <;> linarith
  · obtain ⟨e0, e1, e2, e3, sb0, sb1, sb2, sb3, sb4, ga0, ga1, ga2, ga3, ga4⟩ := h0
    obtain ⟨f0, f1, f2, f3, tb0, tb1, tb2, tb3, tb4, gb0, gb1, gb2, gb3, gb4⟩ := h4
    subst e0 e1 e2 e3 f0 f1 f2 f3
    rcases m.htr 0 1 4 (by decide) (by decide) with h | h <;> linarith
  · obtain ⟨e0, e1, e2, e3, sb0, sb1, sb2, sb3, sb4, ga0, ga1, ga2, ga3, ga4⟩ := h0
    obtain ⟨f0, f1, f2, f3, tb0, tb1, tb2, tb3, tb4, gb0, gb1, gb2, gb3, gb4⟩ := h4
    subst e0 e1 e2 e3 f0 f1 f2 f3
    rcases m.htr 0 3 4 (by decide) (by decide) with h | h <;> linarith
  · obtain ⟨e0, e1, e2, e3, sb0, sb1, sb2, sb3, sb4, ga0, ga1, ga2, ga3, ga4⟩ := h0
    obtain ⟨f0, f1, f2, f3, tb0, tb1, tb2, tb3, tb4, gb0, gb1, gb2, gb3, gb4⟩ := h4
    subst e0 e1 e2 e3 f0 f1 f2 f3
    rcases m.htr 0 1 4 (by decide) (by decide) with h | h <;> linarith
  · obtain ⟨e0, e1, e2, e3, sb0, sb1, sb2, sb3, sb4, ga0, ga1, ga2, ga3, ga4⟩ := h0
    obtain ⟨f0, f1, f2, f3, tb0, tb1, tb2, tb3, tb4, gb0, gb1, gb2, gb3, gb4⟩ := h4
    subst e0 e1 e2 e3 f0 f1 f2 f3
    rcases m.htr 0 3 4 (by decide) (by decide) with h | h <;> linarith
  · obtain ⟨e0, e1, e2, e3, sb0, sb1, sb2, sb3, sb4, ga0, ga1, ga2, ga3, ga4⟩ := h0
    obtain ⟨f0, f1, f2, f3, tb0, tb1, tb2, tb3, tb4, gb0, gb1, gb2, gb3, gb4⟩ := h4
    subst e0 e1 e2 e3 f0 f1 f2 f3
    rcases m.htr 0 3 4 (by decide) (by decide) with h | h <;> linarith
  · obtain ⟨e0, e1, e2, e3, sb0, sb1, sb2, sb3, sb4, ga0, ga1, ga2, ga3, ga4⟩ := h0
    obtain ⟨f0, f1, f2, f3, tb0, tb1, tb2, tb3, tb4, gb0, gb1, gb2, gb3, gb4⟩ := h4
    subst e0 e1 e2 e3 f0 f1 f2 f3
    rcases m.htr 0 1 4 (by decide) (by decide) with h | h <;> linarith
  · obtain ⟨e0, e1, e2, e3, sb0, sb1, sb2, sb3, sb4, ga0, ga1, ga2, ga3, ga4⟩ := h0
    obtain ⟨f0, f1, f2, f3, tb0, tb1, tb2, tb3, tb4, gb0, gb1, gb2, gb3, gb4⟩ := h4
    subst e0 e1 e2 e3 f0 f1 f2 f3
    rcases m.htr 0 1 4 (by decide) (by decide) with h | h <;> linarith

