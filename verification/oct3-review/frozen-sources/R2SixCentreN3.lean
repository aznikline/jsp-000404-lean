import Jsp000404.R2SixCentre

/-!
# `n = 3` terminal geometry: linear leaf closure for the six-centre profile

This module formalises the exact `n = 3` terminal model and replays every
linear leaf kernel-checkably.  The scalar model `N3Model` packages the
corridor bounds (`up_corridor`), the triple `Up`-constraints
(`up_trans`/`up_cap`) and the sorted `theta`s of the five non-anchor centres.
`RowSig` is the score-`1` signature of a defect-`2` row: exactly one of the
five primitive gaps lies in `[2λ, 3λ)` and the rest are `< 2λ`.

For each of the four non-anchor row positions `r ∈ {0, 1, 3, 4}` the theorem
`n3_row_r` enumerates the 24 chord orderings and the 5 big-gap positions and
discharges each leaf by `linarith` over the model hypotheses.  Rows `1` and
`3` have no surviving leaf (`False`); rows `0` and `4` each retain exactly
three survivors, and `n3_between` discharges the nine joint combinations.

The leaf split was discovered with an external LRA model; every leaf here is
an ordinary Lean proof with no external certificate trusted.

Generated by `tools/gen_n3_leaves.py` from z3-verified minimal cores
(`/tmp/n3model/leaf_min_cores.json`); see `STATUS.md` for provenance.
-/

namespace Jsp404

/-- **Scalar model of the `n = 3` six-centre terminal geometry.** -/
structure N3Model where
  lam : ℝ
  p : ℝ
  hlam : 0 < lam
  hp : 3 * lam <= p ∧ p < 4 * lam
  t : Fin 5 → ℝ
  ht : StrictMono t
  ht0 : 0 <= t 0
  ht4 : t 4 <= p - 3 * lam
  d : Fin 5 → Fin 5 → ℝ
  hcor : ∀ i j : Fin 5, i < j → t i + lam ≤ d i j ∧ d i j ≤ p - lam + t j
  htr : ∀ i j k : Fin 5, i < j → j < k →
    (d i j + lam ≤ d j k ∧ d i j < d i k ∧ d i k < d j k) ∨
    (d j k + lam ≤ d i j ∧ d j k < d i k ∧ d i k < d i j)

/-- Sorted-chord data of a defect-`2` row at `n = 3`: end bounds plus the
score-`1` signature — exactly one linear gap in `[2λ, 3λ)`, the rest `< 2λ`. -/
def RowSig (lam pi tl x0 x1 x2 x3 : ℝ) : Prop :=
  tl ≤ x0 ∧ x0 ≤ x1 ∧ x1 ≤ x2 ∧ x2 ≤ x3 ∧ x3 ≤ tl + pi ∧
    ((2 * lam ≤ x0 - tl ∧ x0 - tl < 3 * lam ∧ x1 - x0 < 2 * lam ∧
        x2 - x1 < 2 * lam ∧ x3 - x2 < 2 * lam ∧ tl + pi - x3 < 2 * lam) ∨
     (x0 - tl < 2 * lam ∧ 2 * lam ≤ x1 - x0 ∧ x1 - x0 < 3 * lam ∧
        x2 - x1 < 2 * lam ∧ x3 - x2 < 2 * lam ∧ tl + pi - x3 < 2 * lam) ∨
     (x0 - tl < 2 * lam ∧ x1 - x0 < 2 * lam ∧ 2 * lam ≤ x2 - x1 ∧
        x2 - x1 < 3 * lam ∧ x3 - x2 < 2 * lam ∧ tl + pi - x3 < 2 * lam) ∨
     (x0 - tl < 2 * lam ∧ x1 - x0 < 2 * lam ∧ x2 - x1 < 2 * lam ∧
        2 * lam ≤ x3 - x2 ∧ x3 - x2 < 3 * lam ∧ tl + pi - x3 < 2 * lam) ∨
     (x0 - tl < 2 * lam ∧ x1 - x0 < 2 * lam ∧ x2 - x1 < 2 * lam ∧
        x3 - x2 < 2 * lam ∧ 2 * lam ≤ tl + pi - x3 ∧ tl + pi - x3 < 3 * lam))

theorem perm2_cases {α : Type*} {x y a b : α}
    (h : List.Perm [x, y] [a, b]) : (x = a ∧ y = b) ∨ (x = b ∧ y = a) := by
  have hx : x ∈ ([a, b] : List α) := h.subset (by simp)
  rcases List.mem_pair.mp hx with h | h
  · subst x
    left
    have h' := List.Perm.cons_inv h
    refine ⟨rfl, ?_⟩
    simpa [List.perm_singleton] using h'
  · subst x
    right
    have h' := List.Perm.cons_inv (h.trans (List.Perm.swap a b []).symm)
    refine ⟨rfl, ?_⟩
    simpa [List.perm_singleton] using h'

theorem perm3_cases {α : Type*} {x y z a b c : α}
    (h : List.Perm [x, y, z] [a, b, c]) :
    (x = a ∧ y = b ∧ z = c) ∨ (x = a ∧ y = c ∧ z = b) ∨
    (x = b ∧ y = a ∧ z = c) ∨ (x = b ∧ y = c ∧ z = a) ∨
    (x = c ∧ y = a ∧ z = b) ∨ (x = c ∧ y = b ∧ z = a) := by
  have hx : x ∈ ([a, b, c] : List α) := h.subset (by simp)
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with h | h | h
  · subst x
    rcases perm2_cases (List.Perm.cons_inv h) with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact Or.inl ⟨rfl, rfl, rfl⟩
    · exact Or.inr (Or.inl ⟨rfl, rfl, rfl⟩)
  · subst x
    have h' := List.Perm.cons_inv (h.trans (List.Perm.swap a b [c]).symm)
    rcases perm2_cases h' with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact Or.inr (Or.inr (Or.inl ⟨rfl, rfl, rfl⟩))
    · exact Or.inr (Or.inr (Or.inr (Or.inl ⟨rfl, rfl, rfl⟩)))
  · subst x
    have hm : List.Perm [a, b, c] [c, a, b] :=
      List.perm_middle (a := c) (l₁ := [a, b]) (l₂ := [])
    have h' := List.Perm.cons_inv (h.trans hm)
    rcases perm2_cases h' with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨rfl, rfl, rfl⟩))))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr ⟨rfl, rfl, rfl⟩))))

