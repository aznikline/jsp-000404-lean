theorem n3_row0 (m : N3Model) {x0 x1 x2 x3 : ℝ}
    (hp : List.Perm [x0, x1, x2, x3] [m.d 0 1, m.d 0 2, m.d 0 3, m.d 0 4])
    (hs : RowSig m.lam m.p (m.t 0) x0 x1 x2 x3) :
    (x0 = m.d 0 1 ∧
        x1 = m.d 0 2 ∧
        x2 = m.d 0 3 ∧
        x3 = m.d 0 4 ∧
        m.t 0 <= x0 ∧
        x0 <= x1 ∧
        x1 <= x2 ∧
        x2 <= x3 ∧
        x3 <= m.t 0 + m.p ∧
        (m.d 0 1 - m.t 0) < 2 * m.lam ∧
        (m.d 0 2 - m.d 0 1) < 2 * m.lam ∧
        (m.d 0 3 - m.d 0 2) < 2 * m.lam ∧
        (m.d 0 4 - m.d 0 3) < 2 * m.lam ∧
        2 * m.lam <= (m.t 0 + m.p - m.d 0 4) ∧
        (m.t 0 + m.p - m.d 0 4) < 3 * m.lam) ∨
      (x0 = m.d 0 1 ∧
        x1 = m.d 0 2 ∧
        x2 = m.d 0 4 ∧
        x3 = m.d 0 3 ∧
        m.t 0 <= x0 ∧
        x0 <= x1 ∧
        x1 <= x2 ∧
        x2 <= x3 ∧
        x3 <= m.t 0 + m.p ∧
        (m.d 0 1 - m.t 0) < 2 * m.lam ∧
        (m.d 0 2 - m.d 0 1) < 2 * m.lam ∧
        2 * m.lam <= (m.d 0 4 - m.d 0 2) ∧
        (m.d 0 4 - m.d 0 2) < 3 * m.lam ∧
        (m.d 0 3 - m.d 0 4) < 2 * m.lam ∧
        (m.t 0 + m.p - m.d 0 3) < 2 * m.lam) ∨
      (x0 = m.d 0 2 ∧
        x1 = m.d 0 1 ∧
        x2 = m.d 0 4 ∧
        x3 = m.d 0 3 ∧
        m.t 0 <= x0 ∧
        x0 <= x1 ∧
        x1 <= x2 ∧
        x2 <= x3 ∧
        x3 <= m.t 0 + m.p ∧
        2 * m.lam <= (m.d 0 2 - m.t 0) ∧
        (m.d 0 2 - m.t 0) < 3 * m.lam ∧
        (m.d 0 1 - m.d 0 2) < 2 * m.lam ∧
        (m.d 0 4 - m.d 0 1) < 2 * m.lam ∧
        (m.d 0 3 - m.d 0 4) < 2 * m.lam ∧
        (m.t 0 + m.p - m.d 0 3) < 2 * m.lam) := by
  obtain ⟨hb0, hb1, hb2, hb3, hb4, hg⟩ := hs
  have hc01 := m.hcor 0 1 (by decide)
  have hc02 := m.hcor 0 2 (by decide)
  have hc03 := m.hcor 0 3 (by decide)
  have hc04 := m.hcor 0 4 (by decide)
  have hc12 := m.hcor 1 2 (by decide)
  have hc13 := m.hcor 1 3 (by decide)
  have hc14 := m.hcor 1 4 (by decide)
  have hc23 := m.hcor 2 3 (by decide)
  have hc24 := m.hcor 2 4 (by decide)
  have hc34 := m.hcor 3 4 (by decide)
  obtain ⟨hplo, hphi⟩ := m.hp
  have hlam := m.hlam
  have ht0b := m.ht0
  have ht4b := m.ht4
  have ht01 : m.t 0 < m.t 1 := m.ht (by decide)
  have ht02 : m.t 0 < m.t 2 := m.ht (by decide)
  have ht03 : m.t 0 < m.t 3 := m.ht (by decide)
  have ht04 : m.t 0 < m.t 4 := m.ht (by decide)
  have ht12 : m.t 1 < m.t 2 := m.ht (by decide)
  have ht13 : m.t 1 < m.t 3 := m.ht (by decide)
  have ht14 : m.t 1 < m.t 4 := m.ht (by decide)
  have ht23 : m.t 2 < m.t 3 := m.ht (by decide)
  have ht24 : m.t 2 < m.t 4 := m.ht (by decide)
  have ht34 : m.t 3 < m.t 4 := m.ht (by decide)
  rcases perm4_cases hp with h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h
  · obtain ⟨rfl, rfl, rfl, rfl⟩ := h
    rcases hg with hg | hg | hg | hg | hg
    · exfalso
      rcases m.htr 0 1 2 (by decide) (by decide) with h | h <;> rcases m.htr 0 2 4 (by decide) (by decide) with h | h <;> rcases m.htr 1 2 4 (by decide) (by decide) with h | h <;> linarith
    · exfalso
      rcases m.htr 0 2 3 (by decide) (by decide) with h | h <;> linarith
    · exfalso
      rcases m.htr 0 3 4 (by decide) (by decide) with h | h <;> linarith
    · exfalso
      rcases m.htr 0 1 2 (by decide) (by decide) with h | h <;> rcases m.htr 0 2 3 (by decide) (by decide) with h | h <;> rcases m.htr 0 2 4 (by decide) (by decide) with h | h <;> rcases m.htr 0 3 4 (by decide) (by decide) with h | h <;> rcases m.htr 1 2 3 (by decide) (by decide) with h | h <;> rcases m.htr 1 2 4 (by decide) (by decide) with h | h <;> rcases m.htr 2 3 4 (by decide) (by decide) with h | h <;> linarith
    · exact Or.inl ⟨rfl, rfl, rfl, rfl, hb0, hb1, hb2, hb3, hb4, hg⟩
  · obtain ⟨rfl, rfl, rfl, rfl⟩ := h
    rcases hg with hg | hg | hg | hg | hg
    · exfalso
      rcases m.htr 0 1 2 (by decide) (by decide) with h | h <;> rcases m.htr 0 2 4 (by decide) (by decide) with h | h <;> rcases m.htr 1 2 4 (by decide) (by decide) with h | h <;> linarith
    · exfalso
      rcases m.htr 0 2 3 (by decide) (by decide) with h | h <;> linarith
    · exact Or.inr (Or.inl ⟨rfl, rfl, rfl, rfl, hb0, hb1, hb2, hb3, hb4, hg⟩)
    · exfalso
      rcases m.htr 0 3 4 (by decide) (by decide) with h | h <;> linarith
    · exfalso
