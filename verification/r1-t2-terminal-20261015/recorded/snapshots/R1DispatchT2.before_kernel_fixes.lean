/-! ### Terminal dispatch -/

/-- **R1 T2 terminal exclusion.**  A seven-centre `n = 4` legal
configuration with saturated anchor `v`, defect-`2` row `a`, tails of
defect `≥ 3` and `Φ = 21` is impossible: bookkeeping gives a unique
defect-`4` tail `z`, and each of the 30 θ-rank assignments `(ra, rz)` is
excluded by a T2 spec certificate. -/
theorem r1_seven_phi21_terminal
    (o : Orientation ℝ Plane₂ (Fin 2)) (e : Plane₂) (he : e ≠ 0)
    {lam : ℝ} (hlam : 0 < lam) (hn : Nat.floor (Real.pi / lam) = 4)
    {c : Fin 7 → Plane₂} (hleg : Section4Legality c lam)
    {v a : Fin 7} (hva : v ≠ a)
    (hsat : rowDefect 4 lam (directionRow o e c v) = 1)
    (hda : rowDefect 4 lam (directionRow o e c a) = 2)
    (htail : ∀ w : Fin 7, w ≠ v → w ≠ a →
      3 ≤ rowDefect 4 lam (directionRow o e c w))
    (hF : potential lam (directionRows o e c) = 21) : False := by
  classical
  obtain ⟨z, hzv, hza, hdz, hrest⟩ :=
    r1_phi21_unique_defect4 o e he hlam hn hleg hva hsat hda htail hF
  obtain ⟨e', he', theta, htheta⟩ :=
    saturated_ray_window o e he (by omega) (by omega) hlam hn hleg v hsat
  have C : SatChart o e' 4 lam c v theta :=
    ⟨he', by omega, hlam, hn, hleg, htheta⟩
  have href : ∀ x : Fin 7,
      rowDefect 4 lam (directionRow o e' c x) =
        rowDefect 4 lam (directionRow o e c x) := fun x =>
    rowDefect_directionRow_reference_eq o e' e he' he c hleg.inj x
      hlam (by omega) hn
  obtain ⟨ua, hua⟩ := Fin.exists_succAbove_eq hva.symm
  obtain ⟨uz, huz⟩ := Fin.exists_succAbove_eq hzv.symm
  obtain ⟨ra, hra⟩ := (n7σ_bijective C).surjective ua
  obtain ⟨rz, hrz⟩ := (n7σ_bijective C).surjective uz
  have hza_idx : uz ≠ ua := fun h => hza (by rw [← huz, h, hua])
  have hrz_ne : rz ≠ ra := fun h =>
    hza_idx (by rw [← hrz, ← hra, h])
  have hd2 : rowDefect 4 lam
      (directionRow o e' c (v.succAbove ua)) = 2 := by
    rw [hua, href]; exact hda
  have hd3 : ∀ u : Fin 6, u ≠ ua → u ≠ uz →
      rowDefect 4 lam
        (directionRow o e' c (v.succAbove u)) = 3 := by
    intro u hna hnz
    have hwv : v.succAbove u ≠ v := Fin.succAbove_ne v u
    have hwa : v.succAbove u ≠ a := fun hh =>
      hna (Fin.succAbove_right_injective (hh.trans hua.symm))
    have hwz : v.succAbove u ≠ z := fun hh =>
      hnz (Fin.succAbove_right_injective (hh.trans huz.symm))
    rw [href]; exact hrest _ hwv hwa hwz
  have hd3r : ∀ r : Fin 6, n7σ C r ≠ ua → n7σ C r ≠ uz →
      rowDefect 4 lam
        (directionRow o e' c (v.succAbove (n7σ C r))) = 3 :=
    fun r h1 h2 => hd3 _ h1 h2
  fin_cases ra
  · fin_cases rz
    · exact absurd rfl hrz_ne
    · have h2na : n7σ C 2 ≠ ua := fun hh =>
        absurd ((n7σ_bijective C).injective
          (hh.trans hra.symm)) (by decide)
      have h2nz : n7σ C 2 ≠ uz := fun hh =>
        absurd ((n7σ_bijective C).injective
          (hh.trans hrz.symm)) (by decide)
      have h3na : n7σ C 3 ≠ ua := fun hh =>
