theorem mask551_impossible (M : GenericModel 5 4)
    (hword : WordSound M SixWeakAllGroup03Data.Mask551.word)
    (hdef1 : SatScalarModel.rowDefect M 1 ≤ 2)
    (hdef3 : SatScalarModel.rowDefect M 3 ≤ 3)
    : False := by
  exact SixWeakOuterReplaySoundness.leafCheckA_sound M SixWeakAllGroup03Data.Mask551.word hword SixWeakAllGroup03Data.Mask551.rows
