theorem correct (id : Fin 24698) (hlow : 3200 ≤ id.val) (hhigh : id.val < 3328) :
    leafCheck library (N4R2WordTree.catalog id) (lookup (id.val - 3200)) = true := by
  let j : Fin 128 := ⟨id.val - 3200, by omega⟩
  have hsum : 3200 + j.val = id.val := by dsimp [j]; omega
  have hindex : Fin.ofNat 24698 (3200 + j.val) = id := by
    apply Fin.ext
    simp only [Fin.ofNat, hsum, Nat.mod_eq_of_lt id.isLt]
  have hh := point_checked j
  rw [hindex] at hh
  exact hh

