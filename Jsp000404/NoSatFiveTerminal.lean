theorem five_model_impossible {lam p : ℝ} (m : FiveModel lam p) (q : Fin 5)
    (hpos : ∀ i : Fin 5, i ≠ q → ∃ j : Fin 5, j ≠ i ∧
      ∀ k : Fin 5, k ≠ i →
      (if m.d i k < m.d i j then m.d i k+p-m.d i j else m.d i k-m.d i j) ≤ p-2*lam) :
    False := by
  fin_cases q
  · exact five_model_exclusion_0 m hpos
  · exact five_model_exclusion_1 m hpos
  · exact five_model_exclusion_2 m hpos
  · exact five_model_exclusion_3 m hpos
  · exact five_model_exclusion_4 m hpos

#print axioms five_model_impossible
end Jsp404.NoSatFiveTerminal
