theorem correct (id : Fin 24698) (hlow : 7552 ≤ id.val) (hhigh : id.val < 7680) :
    leafCheck library (N4R2WordTree.catalog id) (lookup (id.val - 7552)) = true := by
  let j : Fin 128 := ⟨id.val - 7552, by omega⟩
  have hsum : 7552 + j.val = id.val := by dsimp [j]; omega
  have hindex : Fin.ofNat 24698 (7552 + j.val) = id := by
    apply Fin.ext
    simp only [Fin.ofNat, hsum, Nat.mod_eq_of_lt id.isLt]
  have hh := point_checked j
  rw [hindex] at hh
  exact hh

