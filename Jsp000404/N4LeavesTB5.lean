theorem n4l_tB_0_0_4 (m : N4Model)
    (h0 : MSig1_0 m.lam m.p (m.t 0) (m.d 0 1) (m.d 0 2) (m.d 0 3) (m.d 0 4))
    (h2 : MSig1_0 m.lam m.p (m.t 2) (m.d 0 2) (m.d 1 2) (m.d 2 3) (m.d 2 4))
    (h3 : MSig2_4 m.lam m.p (m.t 3) (m.d 0 3) (m.d 1 3) (m.d 2 3) (m.d 3 4)) : False := by
  have hlam := m.hlam
  obtain ⟨hplo, hphi⟩ := m.hp
  have ht0b := m.ht0
  have ht4b := m.ht4
  have hc34 := m.hcor 3 4 (by decide)
  have ht01 : m.t 0 < m.t 1 := m.ht (by decide)
  have ht12 : m.t 1 < m.t 2 := m.ht (by decide)
  have ht34 : m.t 3 < m.t 4 := m.ht (by decide)
  obtain ⟨h2elo, _, _, _⟩ := h2
  obtain ⟨h3ehi, _, _, _⟩ := h3
  have u2e2 := h2elo (m.d 2 3) (by simp)
  have u3h2 := h3ehi (m.d 2 3) (by simp)
  have u3h3 := h3ehi (m.d 3 4) (by simp)
  rcases m.htr 2 3 4 (by decide) (by decide) with h0 | h0
  · linarith only [h0, hlam, hphi, ht01, ht0b, ht12, ht34, ht4b, u2e2, u3h3]
  · linarith only [h0, hc34, hlam, hphi, u3h2]

