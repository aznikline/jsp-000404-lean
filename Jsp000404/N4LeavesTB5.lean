    (h3 : MSig2_0 m.lam m.p (m.t 3) (m.d 0 3) (m.d 1 3) (m.d 2 3) (m.d 3 4)) : False := by
  have hlam := m.hlam
  obtain ⟨hplo, hphi⟩ := m.hp
  have ht01 : m.t 0 < m.t 1 := m.ht (by decide)
  have ht12 : m.t 1 < m.t 2 := m.ht (by decide)
  have ht23 : m.t 2 < m.t 3 := m.ht (by decide)
  obtain ⟨h0ehi, _, _, _⟩ := h0
  obtain ⟨h3elo, _, _, _⟩ := h3
  have u0h2 := h0ehi (m.d 0 3) (by simp)
  have u3e0 := h3elo (m.d 0 3) (by simp)
  linarith only [hlam, hphi, ht01, ht12, ht23, u0h2, u3e0]

