theorem shard_182 {lam p : ℝ} (m : ElevenModel lam p)
    (htr016a : m.d 0 1 + lam ≤ m.d 1 6)
    (htr023b : m.d 2 3 < m.d 0 3)
    (htr024a : m.d 2 4 + lam ≤ m.d 0 2)
    (htr034a : m.d 0 3 + lam ≤ m.d 3 4)
    (htr035a : m.d 0 3 + lam ≤ m.d 3 5)
    (htr035b : m.d 0 3 < m.d 0 5)
    (htr035c : m.d 0 5 < m.d 3 5)
    (htr134a : m.d 3 4 + lam ≤ m.d 1 3)
    (htr234a : m.d 2 3 + lam ≤ m.d 3 4)
    (htr236a : m.d 3 6 + lam ≤ m.d 2 3)
    (htr245a : m.d 4 5 + lam ≤ m.d 2 4)
    (htr345a : m.d 4 5 + lam ≤ m.d 3 4)
    (htr345c : m.d 3 5 < m.d 3 4)
    : False :=
  proof_shard_182 m htr016a htr023b htr024a htr034a htr035a htr035b htr035c htr134a htr234a htr236a htr245a htr345a htr345c

#print axioms shard_182
