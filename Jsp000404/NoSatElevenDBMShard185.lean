theorem shard_185 {lam p : ℝ} (m : ElevenModel lam p)
    (htr013c : m.d 0 3 < m.d 1 3)
    (htr014a : m.d 0 1 + lam ≤ m.d 1 4)
    (htr026a : m.d 2 6 + lam ≤ m.d 0 2)
    (htr034a : m.d 3 4 + lam ≤ m.d 0 3)
    (htr035a : m.d 3 5 + lam ≤ m.d 0 3)
    (htr035b : m.d 3 5 < m.d 0 5)
    (htr035c : m.d 0 5 < m.d 0 3)
    (htr134a : m.d 3 4 + lam ≤ m.d 1 3)
    (htr136a : m.d 1 3 + lam ≤ m.d 3 6)
    (htr145a : m.d 1 4 + lam ≤ m.d 4 5)
    (htr234a : m.d 2 3 + lam ≤ m.d 3 4)
    (htr345a : m.d 3 4 + lam ≤ m.d 4 5)
    (htr345b : m.d 3 4 < m.d 3 5)
    : False :=
  proof_shard_185 m htr013c htr014a htr026a htr034a htr035a htr035b htr035c htr134a htr136a htr145a htr234a htr345a htr345b

#print axioms shard_185
