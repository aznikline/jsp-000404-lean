  let j : Fin 128 := ⟨id.val - 24320, by omega⟩
  have hsum : 24320 + j.val = id.val := by dsimp [j]; omega
  have hindex : Fin.ofNat 24698 (24320 + j.val) = id := by
    apply Fin.ext
    simp only [Fin.ofNat, hsum, Nat.mod_eq_of_lt id.isLt]
  have hh := point_checked j
  rw [hindex] at hh
  exact hh

