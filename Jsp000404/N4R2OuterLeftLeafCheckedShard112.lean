theorem correct (id : Fin 24698) (hlow : 14336 ≤ id.val) (hhigh : id.val < 14464) :
    leafCheck library (N4R2WordTree.catalog id) (lookup (id.val - 14336)) = true := by
  let j : Fin 128 := ⟨id.val - 14336, by omega⟩
  have hsum : 14336 + j.val = id.val := by dsimp [j]; omega
  have hindex : Fin.ofNat 24698 (14336 + j.val) = id := by
    apply Fin.ext
    simp only [Fin.ofNat, hsum, Nat.mod_eq_of_lt id.isLt]
  have hh := point_checked j
  rw [hindex] at hh
  exact hh

