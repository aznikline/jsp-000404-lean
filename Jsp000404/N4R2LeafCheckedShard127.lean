theorem correct (id : Fin 24698) (hlow : 16256 ≤ id.val) (hhigh : id.val < 16384) :
    leafCheck library (N4R2WordTree.catalog id) (lookup (id.val - 16256)) = true := by
  let j : Fin 128 := ⟨id.val - 16256, by omega⟩
  have hsum : 16256 + j.val = id.val := by dsimp [j]; omega
  have hindex : Fin.ofNat 24698 (16256 + j.val) = id := by
    apply Fin.ext
    simp only [Fin.ofNat, hsum, Nat.mod_eq_of_lt id.isLt]
  have hh := point_checked j
  rw [hindex] at hh
  exact hh

