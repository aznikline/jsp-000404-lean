theorem shard_452 {lam p : ℝ} (m : ElevenModel lam p)
    (htr015a : m.d 1 5 + lam ≤ m.d 0 1)
    (htr016a : m.d 1 6 + lam ≤ m.d 0 1)
    (htr034b : m.d 3 4 < m.d 0 4)
    (htr035a : m.d 3 5 + lam ≤ m.d 0 3)
    (htr045a : m.d 0 4 + lam ≤ m.d 4 5)
    (htr045b : m.d 0 4 < m.d 0 5)
    (htr045c : m.d 0 5 < m.d 4 5)
    (htr046a : m.d 0 4 + lam ≤ m.d 4 6)
    (htr046b : m.d 0 4 < m.d 0 6)
    (htr046c : m.d 0 6 < m.d 4 6)
    (htr134a : m.d 1 3 + lam ≤ m.d 3 4)
    (htr134b : m.d 1 3 < m.d 1 4)
    (htr135c : m.d 1 5 < m.d 3 5)
    (htr145b : m.d 1 4 < m.d 1 5)
    (htr146b : m.d 1 4 < m.d 1 6)
    (htr234a : m.d 3 4 + lam ≤ m.d 2 3)
    (htr235a : m.d 3 5 + lam ≤ m.d 2 3)
    (htr345a : m.d 3 4 + lam ≤ m.d 4 5)
    (htr345b : m.d 3 4 < m.d 3 5)
    (htr346a : m.d 3 4 + lam ≤ m.d 4 6)
    (htr347a : m.d 4 7 + lam ≤ m.d 3 4)
    (htr347b : m.d 4 7 < m.d 3 7)
    (htr347c : m.d 3 7 < m.d 3 4)
    : False :=
  proof_shard_452 m htr015a htr016a htr034b htr035a htr045a htr045b htr045c htr046a htr046b htr046c htr134a htr134b htr135c htr145b htr146b htr234a htr235a htr345a htr345b htr346a htr347a htr347b htr347c

