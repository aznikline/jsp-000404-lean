theorem correct (id : Fin 24698) (hlow : 17280 ≤ id.val) (hhigh : id.val < 17408) :
    leafCheck library (N4R2WordTree.catalog id) (lookup (id.val - 17280)) = true := by
  let j : Fin 128 := ⟨id.val - 17280, by omega⟩
  have hsum : 17280 + j.val = id.val := by dsimp [j]; omega
  have hindex : Fin.ofNat 24698 (17280 + j.val) = id := by
    apply Fin.ext
    simp only [Fin.ofNat, hsum, Nat.mod_eq_of_lt id.isLt]
  have hh := point_checked j
  rw [hindex] at hh
  exact hh

