theorem n4l_pE_2_7 (m : N4Model)
    (h0 : MSig2_2 m.lam m.p (m.t 0) (m.d 0 1) (m.d 0 2) (m.d 0 3) (m.d 0 4))
    (h4 : MSig2_0_3 m.lam m.p (m.t 4) (m.d 0 4) (m.d 1 4) (m.d 2 4) (m.d 3 4))
    (hem : (m.t 0 + m.p - m.lam < m.d 0 1) ∨ (m.t 0 + m.p - m.lam < m.d 0 2) ∨
      (m.t 0 + m.p - m.lam < m.d 0 3) ∨ (m.d 1 4 < m.t 4 + m.lam) ∨
      (m.d 2 4 < m.t 4 + m.lam) ∨ (m.d 3 4 < m.t 4 + m.lam)) : False := by
  have hlam := m.hlam
  obtain ⟨hplo, hphi⟩ := m.hp
  have hc04 := m.hcor 0 4 (by decide)
  have hc14 := m.hcor 1 4 (by decide)
  have hc24 := m.hcor 2 4 (by decide)
  have hc34 := m.hcor 3 4 (by decide)
