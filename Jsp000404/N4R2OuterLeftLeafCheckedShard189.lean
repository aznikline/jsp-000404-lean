theorem correct (id : Fin 24698) (hlow : 24192 ≤ id.val) (hhigh : id.val < 24320) :
    leafCheck library (N4R2WordTree.catalog id) (lookup (id.val - 24192)) = true := by
  let j : Fin 128 := ⟨id.val - 24192, by omega⟩
  have hsum : 24192 + j.val = id.val := by dsimp [j]; omega
  have hindex : Fin.ofNat 24698 (24192 + j.val) = id := by
    apply Fin.ext
    simp only [Fin.ofNat, hsum, Nat.mod_eq_of_lt id.isLt]
