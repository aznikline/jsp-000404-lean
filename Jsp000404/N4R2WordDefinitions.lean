/-- Arithmetic lexicographic index of the sorted three distinct labels. -/
def tripleIndex (i u v : Fin 7) : Fin 35 :=
  let a := min i.val (min u.val v.val)
  let c := max i.val (max u.val v.val)
  let b := i.val + u.val + v.val - a - c
  Fin.ofNat 35 (35 - ((7-a)*(6-a)*(5-a))/6 +
    ((b-a-1)*(12-a-b))/2 + (c-b-1))

