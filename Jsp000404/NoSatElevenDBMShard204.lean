    ⟨htr6710a, htr6710b, htr6710c, _, _⟩ | ⟨htr6710a, htr6710b, htr6710c, _, _⟩
  ·
    linarith only [hlam, hd23a, hd710b, htr035b, htr056a, htr235a, htr567a, htr6710a]
  ·
    linarith only [hlam, hc467yz, htr3410a, htr347a, htr4710c, htr6710a]

theorem shard_204 {lam p : ℝ} (m : ElevenModel lam p)
    (htr014c : m.d 0 4 < m.d 1 4)
    (htr035b : m.d 3 5 < m.d 0 5)
    (htr036b : m.d 3 6 < m.d 0 6)
    (htr037b : m.d 3 7 < m.d 0 7)
    (htr045c : m.d 0 5 < m.d 0 4)
    (htr046c : m.d 0 6 < m.d 0 4)
    (htr047c : m.d 0 7 < m.d 0 4)
    (htr134c : m.d 1 4 < m.d 1 3)
    (htr234a : m.d 2 3 + lam ≤ m.d 3 4)
    (htr234c : m.d 2 4 < m.d 3 4)
    (htr235a : m.d 2 3 + lam ≤ m.d 3 5)
    (htr236a : m.d 2 3 + lam ≤ m.d 3 6)
    (htr245a : m.d 4 5 + lam ≤ m.d 2 4)
    (htr246a : m.d 4 6 + lam ≤ m.d 2 4)
    (htr345b : m.d 4 5 < m.d 3 5)
    (htr346a : m.d 4 6 + lam ≤ m.d 3 4)
    (htr346b : m.d 4 6 < m.d 3 6)
    (htr347a : m.d 4 7 + lam ≤ m.d 3 4)
    (htr347b : m.d 4 7 < m.d 3 7)
    (htr3410a : m.d 3 4 + lam ≤ m.d 4 10)
    : False :=
  proof_shard_204 m htr014c htr035b htr036b htr037b htr045c htr046c htr047c htr134c htr234a htr234c htr235a htr236a htr245a htr246a htr345b htr346a htr346b htr347a htr347b htr3410a

#print axioms shard_204
end Jsp404.NoSatElevenDBMTerminal
