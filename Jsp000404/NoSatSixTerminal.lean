    (htr024 : m.d 0 2 + lam ≤ m.d 2 4 ∧ m.d 0 2 < m.d 0 4 ∧ m.d 0 4 < m.d 2 4 ∧ m.d 0 4-m.d 0 2 ≤ p-lam ∧ m.d 2 4-m.d 0 4 ≤ p-lam)
    (htr025 : m.d 0 2 + lam ≤ m.d 2 5 ∧ m.d 0 2 < m.d 0 5 ∧ m.d 0 5 < m.d 2 5 ∧ m.d 0 5-m.d 0 2 ≤ p-lam ∧ m.d 2 5-m.d 0 5 ≤ p-lam)
    (htr034 : m.d 0 3 + lam ≤ m.d 3 4 ∧ m.d 0 3 < m.d 0 4 ∧ m.d 0 4 < m.d 3 4 ∧ m.d 0 4-m.d 0 3 ≤ p-lam ∧ m.d 3 4-m.d 0 4 ≤ p-lam)
